{
  "name": "my-website",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "prepare": "git config core.hooksPath .githooks || true",
    "security:scan": "bash scripts/security-scan.sh",
    "pv": "bash scripts/analytics/query.sh"
  },
  "dependencies": {
    "astro": "7.4.1"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.21",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "@cloudflare/config": {
      "zod": "4.6.7"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
