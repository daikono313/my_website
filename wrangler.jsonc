{
  "name": "de",
  "compatibility_date": "2026-10-01",
  // /api/* だけ Worker（src/worker.ts）を通し、それ以外は静的ファイルをそのまま返す（Worker の実行回数を使わない）
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Secrets（ダッシュボードで「シークレット」として設定）: TURNSTILE_SECRET_KEY / CONTACT_GAS_URL / CONTACT_GAS_SECRET
  // ※ ダッシュボードで「変数」（平文）として追加したものは、次の wrangler deploy で消える。必ずシークレットにする
  "observability": { "enabled": true },
  // ページ表示の記録（/api/pv）。Workers Analytics Engine（無料: 1日10万件書き込み・1万回クエリ、保持3か月）
  "analytics_engine_datasets": [{ "binding": "PV", "dataset": "my_website_pageviews" }],
  // PR ごとの Workers Preview（npx wrangler preview）。静的サイトなので Preview 専用の設定はなし
  "previews": {}
}
