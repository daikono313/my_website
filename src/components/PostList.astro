---
import { fmtDate, type Post } from "../lib/posts";
import TagList from "./TagList.astro";

// 一覧ページ用のリスト
interface Props {
  posts: Post[];
  empty: string;
}
const { posts, empty } = Astro.props;
---

{posts.length > 0 ? (
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <time datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
        <div>
          <a class="post-title" href={p.url}>{p.title}</a>
          <p>{p.description}</p>
          <TagList tags={p.tags} />
        </div>
      </li>
    ))}
  </ul>
) : (
  <p class="empty">{empty}</p>
)}
