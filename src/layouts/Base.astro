---
import "../styles/global.css";
import { profile } from "../data/profile";
import SiteNav from "../components/SiteNav.astro";
import type { NavKey } from "../lib/nav";
import { jsonLd, breadcrumbLd } from "../lib/seo";

interface Props {
  title: string;
  description?: string;
  nav?: NavKey;
  /** OGP の og:type。記事・ウィークリーの詳細は "article" */
  type?: "website" | "article";
  published?: Date;
  modified?: Date;
  /** 検索結果に出さないページ（404・検索結果など） */
  noindex?: boolean;
  /** 構造化データ（JSON-LD）。src/lib/seo.ts で組み立てたものを渡す */
  structuredData?: object[];
  /** パンくず。Home から現在のページまで。画面に表示し、BreadcrumbList の構造化データにもする */
  breadcrumb?: { name: string; path: string }[];
}
const { title, description = profile.summary, nav, type = "website", published, modified, noindex = false, structuredData = [], breadcrumb } = Astro.props;

// canonical は常に本番の URL（astro.config.mjs の site）を指す。Preview の URL が検索結果に重複して出ないようにする
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ld = breadcrumb ? [...structuredData, breadcrumbLd(site, breadcrumb)] : structuredData;

// Cloudflare Web Analytics。本番デプロイ時だけ token を渡す（Preview・ローカルでは計測しない）
// 値を HTML 属性に埋め込むため、想定形式（32桁の16進数）以外は無視する
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const beacon = /^[0-9a-f]{32}$/.test(analyticsToken ?? "") ? JSON.stringify({ token: analyticsToken }) : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="author" content={profile.name} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} の記事と Weekly Tech Note`} href="/rss.xml" />
    {ld.map((d) => <script is:inline type="application/ld+json" set:html={jsonLd(d as never)} />)}
    {beacon && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={beacon}></script>}
  </head>
  <body>
    <div class="container">
      <SiteNav current={nav} />
      {breadcrumb && (
        <nav class="breadcrumb" aria-label="パンくずリスト">
          <ol>
            {breadcrumb.map((b, i) =>
              i === breadcrumb.length - 1 ? <li aria-current="page">{b.name}</li> : <li><a href={b.path}>{b.name}</a></li>,
            )}
          </ol>
        </nav>
      )}
      <slot />
      <footer>
        <div>© {new Date().getFullYear()} {profile.name}</div>
        <div><a href="/contact/">contact</a> · <a href={`https://github.com/${profile.githubUser}/my_website`}>source</a></div>
      </footer>
    </div>
    {beacon && (
      <script>
        // ページ表示の記録（/api/pv → Workers Analytics Engine）。Web Analytics と同じく本番だけ
        import "../client/pv";
      </script>
    )}
  </body>
</html>
