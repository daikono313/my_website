---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import TagList from "../../components/TagList.astro";
import { profile } from "../../data/profile";
import { getArticles, fmtDate, type ArticleEntry } from "../../lib/posts";
import { render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props as { article: ArticleEntry };
const { Content } = await render(article);
---

<Base title={`${article.data.title} — ${profile.name}`} description={article.data.description} nav="articles">
  <PageHeader prompt="~/articles" command={`cat ${article.id}.md`} title={article.data.title}>
    <time datetime={article.data.date.toISOString()}>{fmtDate(article.data.date)}</time>
    <TagList tags={article.data.tags} />
  </PageHeader>
  <article class="prose">
    <Content />
  </article>
</Base>
