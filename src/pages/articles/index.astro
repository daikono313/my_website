---
import Base from "../../layouts/Base.astro";
import { profile } from "../../data/profile";
import { getArticles, fmtDate } from "../../lib/articles";

const articles = await getArticles();
---

<Base title={`Articles — ${profile.name}`}>
  <header class="hero compact">
    <div class="prompt"><b>~/articles</b> $ ls -t</div>
    <h1>Articles</h1>
  </header>
  <section>
    {articles.length > 0 ? (
      <ul class="article-list">
        {articles.map((a) => (
          <li>
            <time datetime={a.data.date.toISOString()}>{fmtDate(a.data.date)}</time>
            <div>
              <a href={`/articles/${a.id}/`}>{a.data.title}</a>
              {a.data.draft && <span class="draft">draft</span>}
              <p>{a.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">まだ記事はありません。</p>
    )}
  </section>
</Base>
