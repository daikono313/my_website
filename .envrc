# gh CLI はこのディレクトリでは daikono313 を使う
export GH_TOKEN="$(gh auth token --user daikono313)"

# Cloudflare の読み取り専用トークン（macOS キーチェーンから読む。値はリポジトリに置かない）
# Claude が `npx cf ...` で設定内容を確認するために使う。書き込みはできない（デプロイは CI のみ）
# 登録: security add-generic-password -U -a "$USER" -s cloudflare-readonly-my_website -w
if cf_token="$(security find-generic-password -a "$USER" -s cloudflare-readonly-my_website -w 2>/dev/null)"; then
  export CLOUDFLARE_API_TOKEN="$cf_token"
fi
if cf_account="$(security find-generic-password -a "$USER" -s cloudflare-account-id-my_website -w 2>/dev/null)"; then
  export CLOUDFLARE_ACCOUNT_ID="$cf_account"
fi
unset cf_token cf_account
